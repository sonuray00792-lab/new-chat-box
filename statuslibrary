private lateinit var statusbtn: Button

private val pick_image = 101

class statusActivity : AppCompatActivity() {

    private lateinit var recyclerview: RecyclerView
    private lateinit var adapter: status_adapter
    private val statuslist = ArrayList<user_Status_model>()

    private val dbref = FirebaseDatabase.getInstance().getReference("status")


    var currentuid: String? = null

    private var statusname: String = ""

    private lateinit var statusListener: ValueEventListener


    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        enableEdgeToEdge()

        val user = FirebaseAuth.getInstance().currentUser
        if (user == null) {
            finish()
            return
        }
        currentuid = user.uid

        //statusbar color
        window.statusBarColor = resources.getColor(R.color.spirit, theme)


        setContentView(R.layout.activity_status)
        ViewCompat.setOnApplyWindowInsetsListener(findViewById(R.id.main)) { v, insets ->
            val systemBars = insets.getInsets(WindowInsetsCompat.Type.systemBars())
            v.setPadding(systemBars.left, systemBars.top, systemBars.right, systemBars.bottom)
            insets
        }


        recyclerview = findViewById<RecyclerView>(R.id.statusRecycler)
        recyclerview.layoutManager = LinearLayoutManager(this, LinearLayoutManager.VERTICAL, false)


        val prefs = getSharedPreferences("settings", MODE_PRIVATE)
        val theme = prefs.getString("theme", "light") ?: "light"

        adapter = status_adapter(this, statuslist, object : status_adapter.Mystatusclicklistener{
            override fun onmystatusclick() {
                opengallery()
            }

            override fun onmystatusclick(uid: String) {
                val intent = Intent(this@statusActivity, status_view::class.java)
                intent.putExtra("userid",uid)
                startActivity(intent)
            }

        },theme)

        recyclerview.adapter = adapter

        loadstatus()



    }


    private fun opengallery() {
        val intent = Intent(Intent.ACTION_PICK)
        intent.type = "image/*"
        startActivityForResult(intent, pick_image)
    }

    override fun onActivityResult(
        requestCode: Int,
        resultCode: Int,
        data: Intent?,
    ) {
        super.onActivityResult(requestCode, resultCode, data)



        FirebaseDatabase.getInstance().getReference("user")
            .child(currentuid!!)
            .child("name")
            .addListenerForSingleValueEvent(object : ValueEventListener {

                override fun onDataChange(snapshot: DataSnapshot) {
                    statusname = snapshot.getValue(String::class.java) ?: "No name"



                    if (requestCode == pick_image && resultCode == RESULT_OK && data!!.data != null) {
                        val uri = data.data ?: return
                        convertandupload(uri, statusname)

                        Log.d("checkname", statusname)
                    }

                }

                override fun onCancelled(error: DatabaseError) {
                    Toast.makeText(this@statusActivity, "Error fetching name", Toast.LENGTH_SHORT)
                        .show()
                }

            })


    }


    private fun convertandupload(uri: Uri, stausname: String) {

        val inputStream = contentResolver.openInputStream(uri)
        val bitmap = BitmapFactory.decodeStream(inputStream)

        val baos = ByteArrayOutputStream()
        bitmap.compress(Bitmap.CompressFormat.JPEG, 40, baos)

        val imageBytes = baos.toByteArray()
        val base64Image =
            android.util.Base64.encodeToString(imageBytes, android.util.Base64.DEFAULT)


        val model = statusmodel(
            stname = statusname,
            media = base64Image,
            timestamp = System.currentTimeMillis()
        )


        dbref.child(currentuid!!).push().setValue(model)
            .addOnSuccessListener {
                Toast.makeText(this, "Status Uploaded", Toast.LENGTH_SHORT).show()
            }

    }


    //load in data to list for helping adapter
    private fun loadstatus() {

        statusListener = object : ValueEventListener {
            override fun onDataChange(snapshot: DataSnapshot) {

                statuslist.clear()

                val myStatusList = ArrayList<statusmodel>()
                var myName = "My Status"

                // 🔹 LOOP ALL USERS
                for (usersnap in snapshot.children) {

                    val userStatusList = ArrayList<statusmodel>()
                    var username = ""

                    for (statussnap in usersnap.children) {
                        val model = statussnap.getValue(statusmodel::class.java) ?:continue

                        if (isExpired(model.timestamp)) {
                            // ❌ DELETE FROM FIREBASE
                            statussnap.ref.removeValue()
                        } else {
                            // ✅ VALID STATUS
                            userStatusList.add(model)
                            username = model.stname ?: ""
                        }

                    }

                    // 🔹 CURRENT USER → MY STATUS
                    if (usersnap.key == currentuid) {
                        myStatusList.addAll(userStatusList)
                        if (username.isNotEmpty()) myName = "My Status"
                    }
                    // 🔹 OTHER USERS
                    else if (userStatusList.isNotEmpty()) {
                        statuslist.add(
                            user_Status_model(
                                userid = usersnap.key ?: "",
                                username = username,
                                statuses = userStatusList,
                                isMyStatus = false
                            )
                        )
                    }
                }

                // 🔝 ADD MY STATUS AT TOP (ALWAYS)
                statuslist.add(
                    0,
                    user_Status_model(
                        userid = currentuid ?: "",
                        username = myName,
                        statuses = myStatusList,
                        isMyStatus = true
                    )
                )

                adapter.notifyDataSetChanged()
            }

            override fun onCancelled(error: DatabaseError) {}
        }

        dbref.addValueEventListener(statusListener)
    }


    override fun onDestroy() {
        super.onDestroy()
        dbref.removeEventListener(statusListener)
    }



}
