package com.example.statuslibrary

object StatusUtils {

    private const val DAY_24 = 24 * 60 * 60 * 1000L

    fun isExpired(timestamp: Long): Boolean {
        val now = System.currentTimeMillis()
        return now - timestamp > DAY_24
    }
}

