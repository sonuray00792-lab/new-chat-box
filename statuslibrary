class status_view : AppCompatActivity() {

    private lateinit var imageView: ImageView
    private val handler = Handler(Looper.getMainLooper())

    private val statusList = ArrayList<statusmodel>()
    private var currentIndex = 0

    private lateinit var progressBar : ProgressBar
    private lateinit var profileimage : ImageView
    private lateinit var usernametv : TextView
    private lateinit var backstatus : ImageView

    private var countDownTimer: CountDownTimer? = null
    private var progress = 0




    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContentView(R.layout.activity_status_view)



        imageView = findViewById(R.id.fullStatusImage)
        progressBar = findViewById<ProgressBar>(R.id.statusprogress)
        profileimage = findViewById<ImageView>(R.id.profileImage)
        usernametv = findViewById<TextView>(R.id.username)
        backstatus = findViewById<ImageView>(R.id.backstatus)


        progressBar.max = 100
        progressBar.progress = 0
        progressBar.visibility = View.VISIBLE



        //back status btn
        backstatus.setOnClickListener {
            finish()
        }



        window.statusBarColor = ContextCompat.getColor(this,R.color.black)


        //get user id
        val userid = intent.getStringExtra("userid") ?: run {
            finish()
            return
        }


        //click exit
        val fullscreen = findViewById<FrameLayout>(R.id.clickmain)
        fullscreen.setOnClickListener {
            finish()
        }

        //call load fun
        loadStatuses(userid)

        //call load profile name and pic
        loadprofile(userid)


    }

    private fun loadStatuses(userid: String) {

        FirebaseDatabase.getInstance()
            .getReference("status")
            .child(userid)
            .addListenerForSingleValueEvent(object : ValueEventListener {

                override fun onDataChange(snapshot: DataSnapshot) {
                    statusList.clear()

                    for (snap in snapshot.children) {
                        val model = snap.getValue(statusmodel::class.java)
                        if (model != null && !isExpired(model.timestamp)) {
                            statusList.add(model)
                        } else {
                            // delete expired
                            snap.ref.removeValue()
                        }
                    }

                    if (statusList.isNotEmpty()) {
                        showStatus()
                    } else {
                        finish()
                    }
                }

                override fun onCancelled(error: DatabaseError) {
                    finish()
                }
            })
    }

    private fun showStatus() {

        if (currentIndex >= statusList.size) {
            finish()
            return
        }

        val status = statusList[currentIndex]

        val bytes = Base64.decode(status.media, Base64.DEFAULT)
        val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
        imageView.setImageBitmap(bitmap)

        startProgressTimer(5000)
    }




    private fun startProgressTimer(duration: Long) {

        countDownTimer?.cancel()   // stop old timer
        progressBar.progress = 0

        countDownTimer = object : CountDownTimer(duration, 50) {
            override fun onTick(millisUntilFinished: Long) {
                val progress =
                    ((duration - millisUntilFinished) * 100 / duration).toInt()
                progressBar.progress = progress
            }

            override fun onFinish() {
                progressBar.progress = 100
                currentIndex++
                showStatus()
            }
        }.start()
    }




    private fun loadprofile(userid: String){


        FirebaseDatabase.getInstance().getReference("user")
            .child(userid)
            .addListenerForSingleValueEvent(object : ValueEventListener{

                override fun onDataChange(snapshot: DataSnapshot) {

                    val name = snapshot.child("name").getValue(String::class.java)
                    usernametv.text = name

                    val base64 = snapshot.child("profileimage").getValue(String::class.java)
                    if (!base64.isNullOrEmpty()) {
                        val bytes = Base64.decode(base64, Base64.DEFAULT)
                        val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
                        profileimage.setImageBitmap(bitmap)
                    } else {
                        profileimage.setImageResource(R.drawable.manprofile)
                    }

                }

                override fun onCancelled(error: DatabaseError) {}

            })

    }




    override fun onDestroy() {
        super.onDestroy()
        countDownTimer?.cancel()
    }
}

