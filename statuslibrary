class status_adapter(
    private val context: Context,
    private val list: ArrayList<user_Status_model>,
    private val listener: Mystatusclicklistener,
    private val theme: String
) : RecyclerView.Adapter<status_adapter.ViewHolder>() {

    interface Mystatusclicklistener {
        fun onmystatusclick()
        fun onmystatusclick(uid: String)

    }


    class ViewHolder(itemView: View) : RecyclerView.ViewHolder(itemView) {
        // Image status ke liye
        val imageView: ImageView =
            itemView.findViewById(R.id.statusImage)

        // User name
        val name: TextView =
            itemView.findViewById(R.id.statusName)

        val time: TextView =
            itemView.findViewById<TextView>(R.id.statusTime)

    }


    override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): status_adapter.ViewHolder {
        val view = LayoutInflater.from(context)
            .inflate(R.layout.item_status, parent, false)

        return ViewHolder(view)
    }


    override fun onBindViewHolder(holder: ViewHolder, position: Int) {

        val user = list[position]

        if (theme == "dark") {
            holder.name.setTextColor(Color.WHITE)
        } else {
            holder.name.setTextColor(Color.BLACK)
        }

        if (user.isMyStatus) {
            holder.name.text = "My Status"
            holder.itemView.findViewById<View>(R.id.myStatusDivider).visibility = View.VISIBLE
            holder.itemView.findViewById<ImageView>(R.id.heart).visibility = View.VISIBLE

            if (user.statuses.isEmpty()) {
                // New user / no status → open gallery
                holder.time.text = "Tap to add status"
                val currentuid = FirebaseAuth.getInstance().currentUser!!.uid
                setProfileImageFromUserNode(currentuid, holder.imageView)

                holder.itemView.setOnClickListener {
                    listener.onmystatusclick() // open gallery
                }

            } else {
                // Already has status → open status view
                val lastStatus = user.statuses.last()
                val bytes = Base64.decode(lastStatus.media, Base64.DEFAULT)
                val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
                holder.imageView.setImageBitmap(bitmap)
                holder.time.text = getTimeAgo(lastStatus.timestamp)

                holder.itemView.setOnClickListener {
                    listener.onmystatusclick(user.userid) // open own status
                }
            }

        } else {
            // Other users
            holder.name.text = if (user.username.isBlank()) "No name" else user.username
            val lastStatus = user.statuses.last()
            val bytes = Base64.decode(lastStatus.media, Base64.DEFAULT)
            val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
            holder.imageView.setImageBitmap(bitmap)
            holder.imageView.visibility = View.VISIBLE
            holder.time.text = getTimeAgo(lastStatus.timestamp)

            holder.itemView.setOnClickListener {
                listener.onmystatusclick(user.userid) // open other user's status
            }
        }
    }



    override fun getItemCount(): Int {
        return list.size
    }


    //timing calculate function

    fun getTimeAgo(time: Long): String {
        val now = System.currentTimeMillis()
        val diff = now - time

        val minutes = diff / (1000 * 60)
        val hours = diff / (1000 * 60 * 60)
        val days = diff / (1000 * 60 * 60 * 24)

        return when {
            minutes < 1 -> "Just now"
            minutes < 60 -> "$minutes min ago"
            hours < 24 -> "$hours hr ago"
            days == 1L -> "Yesterday"
            else -> "$days days ago"
        }
    }

    //showmystatuspicinimageview

    fun setProfileImageFromUserNode(
        uid: String,
        imageView: ImageView
    ) {
        FirebaseDatabase.getInstance()
            .getReference("user")
            .child(uid)
            .child("profileimage")
            .addListenerForSingleValueEvent(object : ValueEventListener {

                override fun onDataChange(snapshot: DataSnapshot) {
                    val base64 = snapshot.getValue(String::class.java)
                    if (!base64.isNullOrEmpty()) {
                        val bytes = Base64.decode(base64, Base64.DEFAULT)
                        val bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.size)
                        imageView.setImageBitmap(bitmap)
                    } else {
                        imageView.setImageResource(R.drawable.person)
                    }
                }

                override fun onCancelled(error: DatabaseError) {}
            })
    }


}
